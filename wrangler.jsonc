{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-ops",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relay-ops",
      "database_id": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RelayAgent",
        "class_name": "RelayAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayAgent"]
    }
  ],
  "workflows": [
    {
      "name": "infra-workflow",
      "binding": "INFRA_WORKFLOW",
      "class_name": "InfraWorkflow"
    }
  ],
  "observability": { "enabled": true }
}
